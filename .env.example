# Copy to .env.local (gitignored). Forces the game to treat the Bloxity SDK
# (sdk.bloxity.io) and avatar CDN (static.bloxity.io) as unavailable, so local
# dev boots straight onto the bundled character. Unset/"false": use the real SDK.
VITE_DEV_MODE=false

# Starting cash ($) and starting poop inventory (yield units, sold at $0.01 each).
# Unset, empty, negative or non-numeric: 0. Restart the dev server after changing.
VITE_START_MONEY=0
VITE_START_POOP=0

# Colyseus server (../Poop-a-big-poop-backend) for remote players and saved progress.
# Dev builds (`npm run dev`, `build:dev`) use _DEV (default ws://localhost:2567);
# production builds use _MAIN (empty = stay solo). Both come from GitHub repo
# variables SERVER_URL_DEV / SERVER_URL_MAIN in the deploy workflow.
VITE_SERVER_URL_DEV=ws://localhost:2567
VITE_SERVER_URL_MAIN=
